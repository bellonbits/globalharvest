# Public site URL used for canonical links and Open Graph tags.
VITE_SITE_URL=https://globalharvest.org

# Optional. When set, services send data to this backend instead of the
# local mock adapter (which stores submissions in the browser's localStorage).
# Expected endpoints are documented in src/services/README.md.
VITE_API_BASE_URL=/api

# --- Server-only (Vercel functions in api/) — never prefix with VITE_ ---
# PostgreSQL connection string. Tables live in the "global_harvest" schema (npm run db:migrate).
DATABASE_URL=
# Optional: the provider's CA certificate (PEM) to verify the database TLS certificate.
DATABASE_CA_CERT=
